# Copy this file to .env.test and fill in your Azure credentials.
# .env.test is gitignored and will never be committed.
#
# Run integration tests with:
#   mix test --include integration                  # app-only (client credentials)
#   mix test --include integration_delegated        # delegated (user token)

# Required for integration tests
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Required — a real user UPN in your tenant (used for read tests + member operations)
AZURE_TEST_USER_ID=user@yourdomain.com

# Optional: a valid delegated access token (from Graph Explorer, az cli, etc.)
# AZURE_USER_ACCESS_TOKEN=eyJ0eX...
